# Los parámetros de npm run tienen prioridad sobre estos valores, p. ej.:
#   npm run worker -- --port 4001 --coordinator ws://localhost:3001

# ---------- Coordinator ----------
COORDINATOR_PORT=3000
COORDINATOR_ROLE=PRIMARY
# Milisegundos sin pulso antes de eliminar un worker
HEARTBEAT_TIMEOUT=5000

# ---------- Worker ----------
WORKER_PORT=4000
COORDINATOR_URL=ws://localhost:3000
# URL con la que otros llegan a este worker. Si no se define: http://localhost:<WORKER_PORT>
# WORKER_PUBLIC_URL=http://192.168.1.20:4000
PULSE_INTERVAL=2000
RECONNECT_DELAY=3000
